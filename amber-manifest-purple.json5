{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/jiutian-zhiwei/netarena-malt-purple:v4",
    entrypoint: [
      "python",
      "minimal_a2a_server.py",
      "--host",
      "0.0.0.0",
      "--port",
      "8080"
    ],
    env: {},
    network: {
      endpoints: [
        { name: "endpoint", port: 8080 }
      ]
    }
  },
  config_schema: {
    type: "object",
    properties: {},
    required: [],
    additionalProperties: false
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" }
  },
  exports: {
    a2a: "a2a"
  }
}
